<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/RoundedCorner"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_gravity="left|center"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/ic_action_return"
            android:textColor="@color/text_colors"
            app:backgroundTint="@android:color/transparent"
            android:contentDescription="返回上一页"/>

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srcCompat="@mipmap/ic_launcher_foreground" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="壁纸生成器 4"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="一个次元，只属于你"
            android:textAlignment="center"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statementButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/text_underline"
                android:text="免责声明"
                android:textAlignment="textEnd" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text=" | "
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/agreementButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/text_underline"
                android:text="开源协议" />

            <TextView
                android:id="@+id/textView12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" | "
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/githubButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/text_underline"
                android:text="Github 仓库" />
        </LinearLayout>

        <TextView
            android:id="@+id/version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/version"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="基于 MirlKoi 和 Lolicon API"
            android:gravity="bottom|center_horizontal" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 思锐工作室 2019-2025 保留部分权利"
            android:gravity="bottom|center_horizontal"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>